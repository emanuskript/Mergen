# Public origin allowed to call the API (comma-separated if needed).
CORS_ORIGINS=https://mergen.example.org

# Caddy address. A real DNS name enables automatic HTTPS.
SITE_ADDRESS=mergen.example.org

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-bytes
ANALYTICS_USERNAME=admin
ANALYTICS_PASSWORD=replace-with-a-strong-unique-password

# CPU inference and retention limits.
MAX_POOL_WORKERS=2
TASK_TTL_MINUTES=60
TASK_CLEANUP_INTERVAL_SECONDS=300
MAX_UPLOAD_BYTES=209715200
MAX_BATCH_ENTRIES=1000
MAX_BATCH_UNCOMPRESSED_BYTES=1073741824
